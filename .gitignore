# build output / вывод сборки (любой каталог сборки: build/, build_ref/, build-debug/ …)
build*/
*.o
*.obj
*.a
*.dylib
*.dSYM/
# in-source CMake artefacts (на случай сборки прямо в корне) / артефакты CMake в дереве
/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/Makefile

# IDE / tooling — machine-specific / IDE и тулзы — привязаны к машине
.vscode/
.idea/
compile_commands.json
.cache/
.clangd/

# ROMs & game data — never commit / ромы и игровые данные — не коммитить
*.gen
*.bin
*.md5
*.ppm
*.ini
*.sav

# Nuked-OPN2 — fetched separately (LGPL) / качается отдельно
src/opn2/ym3438.c
src/opn2/ym3438.h

# dev notes kept locally / старый dev-README только локально
README.dev.md
BACKLOG.md

# dev artefacts — renders / screenshots / videos: kept on disk, NOT published.
# dev-арты — рендеры / скриншоты / видео: остаются на диске, в git НЕ публикуем.
# Exception / исключение: level maps (top-down) — карты уровней; README-скриншот.
*.png
!map_diag.png
!screenshot.png
shots/*
!shots/MAP_*.png
videos/

# misc
ztpp_settings.ini
.DS_Store
/profiles
/shots
dist/
BACKLOG.md
